<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
  </focus>
  <desktops>
    <number>1</number>
  </desktops>
  <keyboard>
    <keybind key="F4">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/exit</command>
      </action>
    </keybind>
    <keybind key="Home">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/home</command>
      </action>
    </keybind>
    <keybind key="Super_L">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/home</command>
      </action>
    </keybind>
    <keybind key="Super_R">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/home</command>
      </action>
    </keybind>
    <keybind key="XF86HomePage">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/home</command>
      </action>
    </keybind>
    <keybind key="XF86Back">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/back</command>
      </action>
    </keybind>
    <keybind key="Menu">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/menu</command>
      </action>
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/volumeUp</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/volumeDown</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>/usr/bin/curl --silent --request POST http://127.0.0.1:8787/api/runtime/command/mute</command>
      </action>
    </keybind>
  </keyboard>
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
  </applications>
</openbox_config>
