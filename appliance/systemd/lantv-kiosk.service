[Unit]
Description=WatchOS fullscreen television interface
After=systemd-user-sessions.service network-online.target lantv.service
Requires=lantv.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=lantv
Group=lantv
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=HOME=/home/lantv
WorkingDirectory=/home/lantv
ExecStart=/usr/bin/xinit /opt/lantv/appliance/session/start-lantv.sh -- /usr/lib/xorg/Xorg :0 vt1 -keeptty -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
